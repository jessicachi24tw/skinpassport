# Copy to .env.local and fill in. All keys stay on the server (Next.js API routes).

# --- YouCam AI Skin Analysis (required for live scans) ---
# Console: https://yce.makeupar.com/ -> API Keys
YOUCAM_API_KEY=
# Set to 1 to force demo scans and spend no YouCam units (handy while filming the demo)
#MOCK_YOUCAM=1

# --- Weather (optional) ---
# Without a key, Open-Meteo is used (free, no key, UV + air quality, 16-day forecast).
# With a key, temperature/humidity/air quality come from OpenWeather (5-day forecast).
#OPENWEATHER_API_KEY=

# --- Claude (optional) ---
# Rewrites the summary bullets, and powers "Check a product": an agent with the
# web search tool finds a product's ingredient list when our catalog and Open Beauty Facts don't have it.
# Web search must be allowed for your organization in the Claude Console (about $10 per 1,000 searches).
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-haiku-5-5
#ANTHROPIC_LOOKUP_MODEL=claude-sonnet-5-5

# --- Shop (optional) ---
# Adds your Amazon Associates tag to Buy now links
#NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
